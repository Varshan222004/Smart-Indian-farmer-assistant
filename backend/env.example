# Backend
PORT=5001
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/farmer_assistant

# Auth
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Market / Mandi API (fill later)
MARKET_API_URL=https://api.agmarknet.gov.in/api
MARKET_API_KEY=your_market_api_key_here

# Weather
OPENWEATHER_API_KEY=your_openweather_api_key_here
OPENWEATHER_API_URL=https://api.openweathermap.org/data/2.5/onecall

# Geocoding (reverse geocode)
GEOCODING_API_URL=https://api.opencagedata.com/geocode/v1/json
GEOCODING_API_KEY=your_geocoding_api_key_here

# Chatbot / LLM
LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-pro:generateContent
LLM_API_KEY=your_gemini_or_openai_api_key_here
LLM_PROVIDER=gemini

# Google Translate API
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key_here

# ML Services URLs (for local dev)
CROP_RECO_SERVICE_URL=http://localhost:8001
FERTILIZER_RECO_SERVICE_URL=http://localhost:8002
DISEASE_DETECTOR_SERVICE_URL=http://localhost:8003

# Storage
S3_BUCKET=your_s3_bucket_name
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET=your_s3_secret_key
# For local development, use local storage
USE_LOCAL_STORAGE=true
UPLOAD_DIR=./uploads

